generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MilestoneValidation {
  id    Int    @id
  value String

  @@map("milestone_validation")
}

enum UserAccountStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  ADMIN
  NARRATOR
  PLAYER
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ChronicleStatus {
  PREPARATION
  ACTIVE
  ARCHIVED
}

enum CharacterCreationStep {
  IDENTITY
  ATTRIBUTES
  SKILLS
  BLOOD
  DISCIPLINES
  ADVANTAGES
  HUMANITY
  REVIEW
}

enum SkillDistributionMethod {
  GENERALIST
  BALANCED
  SPECIALIST
}

enum SkillSpecialtyOrigin {
  CREATION
  PREDATOR_TYPE
  EVOLUTION
}

enum DisciplineOrigin {
  CREATION
  PREDATOR_TYPE
  THIN_BLOOD
  EVOLUTION
}

enum ThinBloodAlchemyMethod {
  ATHANOR_CORPORIS
  CALCINATIO
  FIXATIO
}

enum AdvantageCategory {
  MERIT
  BACKGROUND
  FLAW
}

enum CharacterAgeCategory {
  FLEDGLING
  NEONATE
  ANCILLA
  ELDER
}

enum AdvantageSelectionOrigin {
  CREATION
  PREDATOR_TYPE
  THIN_BLOOD
  EVOLUTION
}

enum AdvantageDetailsKind {
  ALLIES
  CONTACT
  RETAINER
  STATUS
  FAME
  INFLUENCE
  MASK
  DARK_SECRET
  MAWLA
  HERD
  RESOURCES
  HAVEN
  SUBSTANCE_USE
  FOLKLORIC_BANE
  FOLKLORIC_BLOCK
  PREY_EXCLUSION
  LORESHEET
  LINGUISTICS
  METHUSELAH_VISAGE
  FAMOUS_FACE
  CHILD_OF_THE_SCENE
  ENEMY
  STALKER
  INFAMY
  DESPISED
  HATRED
  EXILED
  SUSPECT
  SHUNNED
  MORTAL_PRETENDER
}

enum AdvantageMaskBenefit {
  ERASED
  TAILOR
}

enum InventoryItemStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  username     String            @unique
  displayName  String
  passwordHash String
  status       UserAccountStatus @default(ACTIVE)
  roles        UserRole[]        @default([PLAYER])
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  sessions                AuthSession[]
  ownedCharacters         Character[]            @relation("CharacterOwner")
  chronicleParticipations ChronicleParticipant[] @relation("ChronicleParticipantUser")
  experienceMovements     CharacterExperienceMovement[] @relation("CharacterExperienceActor")

  @@index([status])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

enum ChronicleSessionStatus {
  PREPARATION
  COMPLETED
  ARCHIVED
}

model Chronicle {
  id          String          @id @default(uuid()) @db.Uuid
  narratorId  String          @db.Uuid
  name        String
  description String?
  status      ChronicleStatus @default(PREPARATION)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  characters   Character[]            @relation("CharacterChronicle")
  participants ChronicleParticipant[] @relation("ChronicleParticipantChronicle")
  npcs         ChronicleNpc[]          @relation("ChronicleNpcChronicle")
  locations    ChronicleLocation[]     @relation("ChronicleLocationChronicle")
  events       ChronicleEvent[]        @relation("ChronicleEventChronicle")
  sessions     ChronicleSession[]      @relation("ChronicleSessionChronicle")

  @@index([narratorId])
  @@index([status])
  @@map("chronicles")
}

enum ChronicleParticipantRole {
  NARRATOR
  PLAYER
}

enum ChronicleParticipantStatus {
  ACTIVE
  RETIRED
}

model ChronicleParticipant {
  id          String                     @id @default(uuid()) @db.Uuid
  chronicleId String                     @db.Uuid
  userId      String                     @db.Uuid
  role        ChronicleParticipantRole
  status      ChronicleParticipantStatus @default(ACTIVE)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleParticipantChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation("ChronicleParticipantUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([chronicleId, userId])
  @@index([chronicleId, role, status])
  @@index([userId, status])
  @@map("chronicle_participants")
}

enum ChronicleNpcStatus {
  ACTIVE
  ARCHIVED
}

enum ChronicleNpcDetailLevel {
  SIMPLE
}

model ChronicleNpc {
  id            String                  @id @default(uuid()) @db.Uuid
  chronicleId   String                  @db.Uuid
  name          String
  category      String?
  description   String?
  narrativeRole String?
  notes         String?
  status        ChronicleNpcStatus       @default(ACTIVE)
  detailLevel   ChronicleNpcDetailLevel  @default(SIMPLE)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleNpcChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([chronicleId, status])
  @@index([chronicleId, detailLevel])
  @@map("chronicle_npcs")
}

enum ChronicleLocationStatus {
  ACTIVE
  ARCHIVED
}

model ChronicleLocation {
  id               String                  @id @default(uuid()) @db.Uuid
  chronicleId      String                  @db.Uuid
  parentLocationId String?                 @db.Uuid
  name             String
  category         String?
  description      String?
  narratorNotes    String?
  status           ChronicleLocationStatus @default(ACTIVE)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleLocationChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  parentLocation ChronicleLocation?  @relation("ChronicleLocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childLocations ChronicleLocation[] @relation("ChronicleLocationHierarchy")

  @@index([chronicleId, status])
  @@index([chronicleId, parentLocationId])
  @@index([parentLocationId])
  @@map("chronicle_locations")
}

enum ChronicleEventStatus {
  ACTIVE
  ARCHIVED
}

model ChronicleEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  chronicleId        String               @db.Uuid
  title              String
  description        String?
  narratorNotes      String?
  narrativeTimeLabel String?
  realDate           DateTime?            @db.Timestamptz(3)
  timelineOrder      Int
  status             ChronicleEventStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleEventChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([chronicleId, status])
  @@index([chronicleId, timelineOrder])
  @@index([chronicleId, realDate])
  @@map("chronicle_events")
}

model ChronicleSession {
    id            String                 @id @default(uuid()) @db.Uuid
    chronicleId   String                 @db.Uuid
    sessionNumber Int?
    title         String?
    realDate      DateTime?              @db.Timestamptz(3)
    status        ChronicleSessionStatus @default(PREPARATION)
    summary       String?
    narratorNotes String?
    createdAt     DateTime               @default(now()) @db.Timestamptz(3)
    updatedAt     DateTime               @updatedAt @db.Timestamptz(3)

    chronicle Chronicle @relation("ChronicleSessionChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    experienceMovements CharacterExperienceMovement[] @relation("CharacterExperienceSession")

    @@index([chronicleId, status])
    @@index([chronicleId, sessionNumber])
    @@index([chronicleId, realDate])
    @@map("chronicle_sessions")
}

enum CharacterExperienceMovementType {
  GRANT
  SPEND
  CORRECTION
}

enum CharacterExperienceComponent {
  EARNED
  SPENT
}

model CharacterExperienceMovement {
  id                 String                       @id @default(uuid()) @db.Uuid
  characterId        String                       @db.Uuid
  actorId            String                       @db.Uuid
  sessionId          String?                      @db.Uuid
  type               CharacterExperienceMovementType
  component          CharacterExperienceComponent
  amount             Int
  reason             String
  deduplicationKey   String?
  acquisitionType    String?
  acquisitionKey     String?
  correctsMovementId String?                      @db.Uuid
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)

  character Character @relation("CharacterExperienceCharacter", fields: [characterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor     User      @relation("CharacterExperienceActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session   ChronicleSession? @relation("CharacterExperienceSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corrects  CharacterExperienceMovement? @relation("CharacterExperienceCorrection", fields: [correctsMovementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corrections CharacterExperienceMovement[] @relation("CharacterExperienceCorrection")

  @@unique([characterId, deduplicationKey])
  @@index([characterId, createdAt])
  @@index([actorId, createdAt])
  @@index([sessionId])
  @@index([correctsMovementId])
  @@map("character_experience_movements")
}

model Character {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  chronicleId String?         @db.Uuid
  status      CharacterStatus @default(DRAFT)
  revision    Int             @default(1)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  owner     User       @relation("CharacterOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chronicle Chronicle? @relation("CharacterChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  identity      CharacterIdentity?
  creationState CharacterCreationState?
  attributes    CharacterAttributes?
  blood         CharacterBloodState?
  damage        CharacterDamageState?
  skills        CharacterSkill[]
  disciplines   CharacterDiscipline[]
  bloodSorceryRituals CharacterBloodSorceryRitual[]
  oblivionCeremonies  CharacterOblivionCeremony[]
  thinBloodAlchemy    CharacterThinBloodAlchemyState?
  thinBloodFormulas   CharacterThinBloodAlchemyFormula[]
  thinBloodTraits     CharacterThinBloodTrait[]
  advantages          CharacterAdvantageSelection[]
  humanity      CharacterHumanityState?
  convictions   CharacterConviction[]
  touchstones   CharacterTouchstone[]
  inventoryItems CharacterInventoryItem[]
  notes          CharacterNote[]
  historyEntries CharacterHistoryEntry[]
  experienceMovements CharacterExperienceMovement[] @relation("CharacterExperienceCharacter")

  @@index([ownerId])
  @@index([chronicleId])
  @@index([status])
  @@map("characters")
}

model CharacterIdentity {
  id              String  @id @default(uuid()) @db.Uuid
  characterId     String  @unique @db.Uuid
  name            String  @default("")
  concept         String?
  predatorTypeKey String?
  ambition        String?
  clanKey         String?
  sire            String?
  desire          String?
  generation      Int?
  ageCategory     CharacterAgeCategory?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_identities")
}

model CharacterCreationState {
  characterId            String                  @id @db.Uuid
  schemaVersion          Int                     @default(1)
  currentStep            CharacterCreationStep   @default(IDENTITY)
  skillDistributionMethod SkillDistributionMethod @default(BALANCED)
  predatorTypeChoices    Json                    @default("{}")
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_creation_states")
}

model CharacterAttributes {
  characterId String @id @db.Uuid
  strength     Int    @default(1)
  dexterity    Int    @default(1)
  stamina      Int    @default(1)
  charisma     Int    @default(1)
  manipulation Int    @default(1)
  composure    Int    @default(1)
  intelligence Int    @default(1)
  wits         Int    @default(1)
  resolve      Int    @default(1)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_attributes")
}

model CharacterBloodState {
  characterId  String @id @db.Uuid
  bloodPotency Int    @default(1)
  hunger       Int    @default(1)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_blood_states")
}

model CharacterDamageState {
  characterId               String @id @db.Uuid
  healthSuperficial         Int    @default(0)
  healthAggravated          Int    @default(0)
  willpowerSuperficial      Int    @default(0)
  willpowerAggravated       Int    @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_damage_states")
}

model CharacterSkill {
  characterId String @db.Uuid
  skillKey    String
  rating      Int    @default(0)

  character  Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  specialties CharacterSkillSpecialty[]

  @@id([characterId, skillKey])
  @@map("character_skills")
}

model CharacterSkillSpecialty {
  id          String               @id
  characterId String               @db.Uuid
  skillKey    String
  name        String
  origin      SkillSpecialtyOrigin?

  skill CharacterSkill @relation(fields: [characterId, skillKey], references: [characterId, skillKey], onDelete: Cascade)

  @@index([characterId, skillKey])
  @@map("character_skill_specialties")
}

model CharacterDiscipline {
  characterId    String            @db.Uuid
  disciplineKey  String
  contributionKey String
  rating          Int               @default(0)
  origin          DisciplineOrigin?

  character Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  powers    CharacterDisciplinePower[]

  @@id([characterId, disciplineKey, contributionKey])
  @@map("character_disciplines")
}

model CharacterDisciplinePower {
  characterId     String @db.Uuid
  disciplineKey   String
  contributionKey String
  powerKey         String

  discipline CharacterDiscipline @relation(fields: [characterId, disciplineKey, contributionKey], references: [characterId, disciplineKey, contributionKey], onDelete: Cascade)

  @@id([characterId, disciplineKey, contributionKey, powerKey])
  @@map("character_discipline_powers")
}

model CharacterBloodSorceryRitual {
  characterId String @db.Uuid
  ritualKey   String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, ritualKey])
  @@map("character_blood_sorcery_rituals")
}

model CharacterOblivionCeremony {
  characterId String @db.Uuid
  ceremonyKey String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, ceremonyKey])
  @@map("character_oblivion_ceremonies")
}

model CharacterThinBloodAlchemyState {
  characterId String                  @id @db.Uuid
  rating      Int                     @default(0)
  method      ThinBloodAlchemyMethod?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_thin_blood_alchemy_states")
}

model CharacterThinBloodAlchemyFormula {
  characterId String @db.Uuid
  formulaKey  String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, formulaKey])
  @@map("character_thin_blood_alchemy_formulas")
}

model CharacterThinBloodTrait {
  characterId                        String  @db.Uuid
  definitionKey                      String
  clanCurseClanKey                   String?
  disciplineAffinityDisciplineKey    String?
  disciplineAffinityPowerKey         String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, definitionKey])
  @@map("character_thin_blood_traits")
}

model CharacterAdvantageSelection {
  characterId      String                   @db.Uuid
  selectionId      String
  definitionKey    String
  category         AdvantageCategory
  rating           Int
  origin           AdvantageSelectionOrigin
  parentSelectionId String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  parent    CharacterAdvantageSelection?  @relation("CharacterAdvantageParent", fields: [characterId, parentSelectionId], references: [characterId, selectionId], onDelete: NoAction, onUpdate: NoAction)
  children  CharacterAdvantageSelection[] @relation("CharacterAdvantageParent")
  details   CharacterAdvantageDetails?

  @@id([characterId, selectionId])
  @@index([characterId, parentSelectionId])
  @@map("character_advantage_selections")
}

model CharacterAdvantageDetails {
  characterId      String @db.Uuid
  selectionId      String
  kind             AdvantageDetailsKind
  effectiveness    Int?
  reliability      Int?
  identity         String?
  sphere           String?
  maskBenefits     AdvantageMaskBenefit[] @default([])
  secret           String?
  resourceSource   String?
  substance        String?
  poolCategory     String?
  folkloricSource  String?
  taboo            String?
  excludedPrey     String?
  loresheetKey     String?
  benefitKey       String?
  languages        String[] @default([])
  resembles        String?
  subculture       String?
  description      String?

  selection CharacterAdvantageSelection @relation(fields: [characterId, selectionId], references: [characterId, selectionId], onDelete: Cascade)

  @@id([characterId, selectionId])
  @@map("character_advantage_details")
}

model CharacterHumanityState {
  characterId String @id @db.Uuid
  value       Int    @default(7)
  stains      Int    @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_humanity_states")
}

model CharacterTouchstone {
  characterId  String @db.Uuid
  touchstoneId String
  name         String
  relationship String

  character   Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  convictions CharacterConviction[]

  @@id([characterId, touchstoneId])
  @@map("character_touchstones")
}

model CharacterConviction {
  characterId  String  @db.Uuid
  convictionId String
  text         String
  touchstoneId String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  touchstone CharacterTouchstone? @relation(fields: [characterId, touchstoneId], references: [characterId, touchstoneId], onDelete: Restrict)

  @@id([characterId, convictionId])
  @@index([characterId, touchstoneId])
  @@map("character_convictions")
}

model CharacterInventoryItem {
  id          String              @id @default(uuid()) @db.Uuid
  characterId String              @db.Uuid
  name        String
  quantity    Int                 @default(1)
  description String?
  category    String?
  notes       String?
  status      InventoryItemStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, status])
  @@map("character_inventory_items")
}

model CharacterNote {
  id          String   @id @default(uuid()) @db.Uuid
  characterId String   @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("character_notes")
}

model CharacterHistoryEntry {
  id          String   @id @default(uuid()) @db.Uuid
  characterId String   @db.Uuid
  title       String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("character_history_entries")
}
