enum ChronicleStoryType {
  MAIN_ARC
  SECONDARY_ARC
  PERSONAL_ARC
}

enum ChronicleStoryVisibility {
  NARRATOR_ONLY
  CHRONICLE_PARTICIPANTS
}

enum ChronicleStoryStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ChronicleStoryMilestoneKey {
  HOOK
  FIRST_TURN
  REVELATION
  CLIMAX
  RESOLUTION
}

model ChronicleStory {
  id              String                   @id @default(uuid()) @db.Uuid
  chronicleId     String                   @db.Uuid
  createdById     String                   @db.Uuid
  title           String
  type            ChronicleStoryType       @default(MAIN_ARC)
  premise         String?
  stakes          String?
  resolution      String?
  narratorNotes   String?
  sharedSummary   String?
  visibility      ChronicleStoryVisibility @default(NARRATOR_ONLY)
  status          ChronicleStoryStatus     @default(PLANNED)
  sortOrder       Int
  revision        Int                      @default(1)
  startedAt       DateTime?                @db.Timestamptz(3)
  completedAt     DateTime?                @db.Timestamptz(3)
  archivedAt      DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleStoryChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User @relation("ChronicleStoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  milestones ChronicleStoryMilestone[] @relation("ChronicleStoryMilestoneStory")
  reminders ChronicleStoryReminder[] @relation("ChronicleStoryReminderStory")
  sessionLinks ChronicleStorySession[] @relation("ChronicleStorySessionStory")
  eventLinks ChronicleStoryEvent[] @relation("ChronicleStoryEventStory")
  characterLinks ChronicleStoryCharacter[] @relation("ChronicleStoryCharacterStory")
  npcLinks ChronicleStoryNpc[] @relation("ChronicleStoryNpcStory")
  locationLinks ChronicleStoryLocation[] @relation("ChronicleStoryLocationStory")
  completionOperation ChronicleStoryCompletionOperation? @relation("ChronicleStoryCompletionStory")
  experienceMovements CharacterExperienceMovement[] @relation("CharacterExperienceStory")

  @@unique([id, chronicleId])
  @@unique([chronicleId, sortOrder])
  @@index([chronicleId, status, sortOrder])
  @@index([createdById, createdAt])
  @@map("chronicle_stories")
}

