generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MilestoneValidation {
  id    Int    @id
  value String

  @@map("milestone_validation")
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CharacterCreationStep {
  IDENTITY
  ATTRIBUTES
  SKILLS
  BLOOD
  DISCIPLINES
  ADVANTAGES
  HUMANITY
  REVIEW
}

enum SkillDistributionMethod {
  GENERALIST
  BALANCED
  SPECIALIST
}

enum SkillSpecialtyOrigin {
  CREATION
  PREDATOR_TYPE
}

enum DisciplineOrigin {
  CREATION
  PREDATOR_TYPE
  THIN_BLOOD
}

enum ThinBloodAlchemyMethod {
  ATHANOR_CORPORIS
  CALCINATIO
  FIXATIO
}

enum AdvantageCategory {
  MERIT
  BACKGROUND
  FLAW
}

enum AdvantageSelectionOrigin {
  CREATION
  PREDATOR_TYPE
  THIN_BLOOD
}

enum AdvantageDetailsKind {
  ALLIES
  CONTACT
  RETAINER
  STATUS
  FAME
  INFLUENCE
  MASK
  DARK_SECRET
  MAWLA
  HERD
  RESOURCES
  HAVEN
  SUBSTANCE_USE
  FOLKLORIC_BANE
  FOLKLORIC_BLOCK
  PREY_EXCLUSION
  LORESHEET
  LINGUISTICS
  METHUSELAH_VISAGE
  FAMOUS_FACE
  CHILD_OF_THE_SCENE
  ENEMY
  STALKER
  INFAMY
  DESPISED
  HATRED
  EXILED
  SUSPECT
  SHUNNED
  MORTAL_PRETENDER
}

enum AdvantageMaskBenefit {
  ERASED
  TAILOR
}

model Character {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  chronicleId String?         @db.Uuid
  status      CharacterStatus @default(DRAFT)
  revision    Int             @default(1)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  identity      CharacterIdentity?
  creationState CharacterCreationState?
  attributes    CharacterAttributes?
  blood         CharacterBloodState?
  skills        CharacterSkill[]
  disciplines   CharacterDiscipline[]
  bloodSorceryRituals CharacterBloodSorceryRitual[]
  oblivionCeremonies  CharacterOblivionCeremony[]
  thinBloodAlchemy    CharacterThinBloodAlchemyState?
  thinBloodFormulas   CharacterThinBloodAlchemyFormula[]
  thinBloodTraits     CharacterThinBloodTrait[]
  advantages          CharacterAdvantageSelection[]
  humanity      CharacterHumanityState?
  convictions   CharacterConviction[]
  touchstones   CharacterTouchstone[]

  @@index([ownerId])
  @@index([chronicleId])
  @@index([status])
  @@map("characters")
}

model CharacterIdentity {
  id              String  @id @default(uuid()) @db.Uuid
  characterId     String  @unique @db.Uuid
  name            String  @default("")
  concept         String?
  predatorTypeKey String?
  ambition        String?
  clanKey         String?
  sire            String?
  desire          String?
  generation      Int?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_identities")
}

model CharacterCreationState {
  characterId            String                  @id @db.Uuid
  schemaVersion          Int                     @default(1)
  currentStep            CharacterCreationStep   @default(IDENTITY)
  skillDistributionMethod SkillDistributionMethod @default(BALANCED)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_creation_states")
}

model CharacterAttributes {
  characterId String @id @db.Uuid
  strength     Int    @default(1)
  dexterity    Int    @default(1)
  stamina      Int    @default(1)
  charisma     Int    @default(1)
  manipulation Int    @default(1)
  composure    Int    @default(1)
  intelligence Int    @default(1)
  wits         Int    @default(1)
  resolve      Int    @default(1)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_attributes")
}

model CharacterBloodState {
  characterId  String @id @db.Uuid
  bloodPotency Int    @default(1)
  hunger       Int    @default(1)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_blood_states")
}

model CharacterSkill {
  characterId String @db.Uuid
  skillKey    String
  rating      Int    @default(0)

  character  Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  specialties CharacterSkillSpecialty[]

  @@id([characterId, skillKey])
  @@map("character_skills")
}

model CharacterSkillSpecialty {
  id          String               @id
  characterId String               @db.Uuid
  skillKey    String
  name        String
  origin      SkillSpecialtyOrigin?

  skill CharacterSkill @relation(fields: [characterId, skillKey], references: [characterId, skillKey], onDelete: Cascade)

  @@index([characterId, skillKey])
  @@map("character_skill_specialties")
}

model CharacterDiscipline {
  characterId  String            @db.Uuid
  disciplineKey String
  rating        Int               @default(0)
  origin        DisciplineOrigin?

  character Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  powers    CharacterDisciplinePower[]

  @@id([characterId, disciplineKey])
  @@map("character_disciplines")
}

model CharacterDisciplinePower {
  characterId  String @db.Uuid
  disciplineKey String
  powerKey      String

  discipline CharacterDiscipline @relation(fields: [characterId, disciplineKey], references: [characterId, disciplineKey], onDelete: Cascade)

  @@id([characterId, disciplineKey, powerKey])
  @@map("character_discipline_powers")
}

model CharacterBloodSorceryRitual {
  characterId String @db.Uuid
  ritualKey   String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, ritualKey])
  @@map("character_blood_sorcery_rituals")
}

model CharacterOblivionCeremony {
  characterId String @db.Uuid
  ceremonyKey String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, ceremonyKey])
  @@map("character_oblivion_ceremonies")
}

model CharacterThinBloodAlchemyState {
  characterId String                  @id @db.Uuid
  rating      Int                     @default(0)
  method      ThinBloodAlchemyMethod?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_thin_blood_alchemy_states")
}

model CharacterThinBloodAlchemyFormula {
  characterId String @db.Uuid
  formulaKey  String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, formulaKey])
  @@map("character_thin_blood_alchemy_formulas")
}

model CharacterThinBloodTrait {
  characterId                        String  @db.Uuid
  definitionKey                      String
  clanCurseClanKey                   String?
  disciplineAffinityDisciplineKey    String?
  disciplineAffinityPowerKey         String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, definitionKey])
  @@map("character_thin_blood_traits")
}

model CharacterAdvantageSelection {
  characterId      String                   @db.Uuid
  selectionId      String
  definitionKey    String
  category         AdvantageCategory
  rating           Int
  origin           AdvantageSelectionOrigin
  parentSelectionId String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  parent    CharacterAdvantageSelection?  @relation("CharacterAdvantageParent", fields: [characterId, parentSelectionId], references: [characterId, selectionId], onDelete: NoAction, onUpdate: NoAction)
  children  CharacterAdvantageSelection[] @relation("CharacterAdvantageParent")
  details   CharacterAdvantageDetails?

  @@id([characterId, selectionId])
  @@index([characterId, parentSelectionId])
  @@map("character_advantage_selections")
}

model CharacterAdvantageDetails {
  characterId      String @db.Uuid
  selectionId      String
  kind             AdvantageDetailsKind
  effectiveness    Int?
  reliability      Int?
  identity         String?
  sphere           String?
  maskBenefits     AdvantageMaskBenefit[] @default([])
  secret           String?
  resourceSource   String?
  substance        String?
  poolCategory     String?
  folkloricSource  String?
  taboo            String?
  excludedPrey     String?
  loresheetKey     String?
  benefitKey       String?
  languages        String[] @default([])
  resembles        String?
  subculture       String?
  description      String?

  selection CharacterAdvantageSelection @relation(fields: [characterId, selectionId], references: [characterId, selectionId], onDelete: Cascade)

  @@id([characterId, selectionId])
  @@map("character_advantage_details")
}

model CharacterHumanityState {
  characterId String @id @db.Uuid
  value       Int    @default(7)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_humanity_states")
}

model CharacterTouchstone {
  characterId  String @db.Uuid
  touchstoneId String
  name         String
  relationship String

  character   Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  convictions CharacterConviction[]

  @@id([characterId, touchstoneId])
  @@map("character_touchstones")
}

model CharacterConviction {
  characterId  String  @db.Uuid
  convictionId String
  text         String
  touchstoneId String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  touchstone CharacterTouchstone? @relation(fields: [characterId, touchstoneId], references: [characterId, touchstoneId], onDelete: Restrict)

  @@id([characterId, convictionId])
  @@index([characterId, touchstoneId])
  @@map("character_convictions")
}
