generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MilestoneValidation {
  id    Int    @id
  value String

  @@map("milestone_validation")
}

enum UserAccountStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  ADMIN
  NARRATOR
  PLAYER
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CharacterNature {
  HUMAN
  VAMPIRE
}

enum CharacterBloodSourceKind {
  HUMAN
  ANIMAL
}

enum CharacterBloodResonanceKey {
  CHOLERIC
  MELANCHOLY
  PHLEGMATIC
  SANGUINE
}

enum CharacterBloodTemperament {
  FLEETING
  INTENSE
  ACUTE
}

enum CharacterBloodSpecialAffinityKey {
  ANIMAL_BLOOD
  RESONANCE_FREE
}

enum CharacterBloodDyscrasiaAcquisitionMode {
  DRAIN_AND_KILL
  FEED_THREE_NIGHTS
}

enum CharacterBloodDyscrasiaKey {
  AGGRESSIVE
  CYCLE_OF_VIOLENCE
  ENERGETIC
  ENVY
  BULLY
  RIGHTEOUS
  VENGEFUL
  LOST_LOVE
  GRIEVING
  EVOCATIVE
  COLOSSAL_FAILURE
  NOSTALGIC
  LOST_RELATIVE
  COMFORTABLY_NUMB
  EATING_YOUR_EMOTIONS
  GIVEN_UP
  LONE_WOLF
  PROCRASTINATE
  REFLECTION
  RELAXED
  TRUE_LOVE
  MANIC_HIGH
  EXCITED
  ENTHUSIASTIC_ABOUT_LIFE
  CONTAGIOUS_ENTHUSIASM
  SNIFFING_GAME
}

enum CharacterCreationMode {
  STANDARD
  SESSION_ZERO
}

enum ChronicleStatus {
  PREPARATION
  ACTIVE
  ARCHIVED
}

enum CharacterCreationStep {
  IDENTITY
  ATTRIBUTES
  SKILLS
  BLOOD
  DISCIPLINES
  ADVANTAGES
  HUMANITY
  REVIEW
}

enum SkillDistributionMethod {
  GENERALIST
  BALANCED
  SPECIALIST
}

enum SkillSpecialtyOrigin {
  CREATION
  PREDATOR_TYPE
  EVOLUTION
}

enum DisciplineOrigin {
  CREATION
  PREDATOR_TYPE
  THIN_BLOOD
  EVOLUTION
}

enum ThinBloodAlchemyMethod {
  ATHANOR_CORPORIS
  CALCINATIO
  FIXATIO
}

enum AdvantageCategory {
  MERIT
  BACKGROUND
  FLAW
}

enum CharacterAgeCategory {
  FLEDGLING
  NEONATE
  ANCILLA
  ELDER
}

enum AdvantageSelectionOrigin {
  CREATION
  PREDATOR_TYPE
  THIN_BLOOD
  EVOLUTION
}

enum AdvantageDetailsKind {
  ALLIES
  CONTACT
  RETAINER
  STATUS
  FAME
  INFLUENCE
  MASK
  DARK_SECRET
  MAWLA
  HERD
  RESOURCES
  HAVEN
  SUBSTANCE_USE
  FOLKLORIC_BANE
  FOLKLORIC_BLOCK
  PREY_EXCLUSION
  LORESHEET
  LINGUISTICS
  METHUSELAH_VISAGE
  FAMOUS_FACE
  CHILD_OF_THE_SCENE
  ENEMY
  STALKER
  INFAMY
  DESPISED
  HATRED
  EXILED
  SUSPECT
  SHUNNED
  MORTAL_PRETENDER
}

enum AdvantageMaskBenefit {
  ERASED
  TAILOR
}

enum InventoryItemStatus {
  ACTIVE
  ARCHIVED
}

model User {
  createdChronicleStories ChronicleStory[] @relation("ChronicleStoryCreatedBy")
  completedStoryMilestones ChronicleStoryMilestone[] @relation("ChronicleStoryMilestoneCompletedBy")
  storyCompletionOperations ChronicleStoryCompletionOperation[] @relation("ChronicleStoryCompletionActor")
  id           String            @id @default(uuid()) @db.Uuid
  username     String            @unique
  displayName  String
  passwordHash String
  status       UserAccountStatus @default(ACTIVE)
  roles        UserRole[]        @default([PLAYER])
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  sessions                AuthSession[]
  ownedCharacters         Character[]            @relation("CharacterOwner")
  chronicleParticipations ChronicleParticipant[] @relation("ChronicleParticipantUser")
  experienceMovements     CharacterExperienceMovement[] @relation("CharacterExperienceActor")
  executedDiceRolls       DiceRollRecord[] @relation("DiceRollActor")
  rouseCheckOperations    CharacterRouseCheckOperation[] @relation("RouseCheckActor")
  blushOfLifeExemptions   CharacterBlushOfLifeExemptionOperation[] @relation("BlushOfLifeExemptionActor")
  chronicleSessionNotes   ChronicleSessionParticipantNote[] @relation("ChronicleSessionParticipantNoteAuthor")
  dashboardContext UserDashboardContext?

  @@index([status])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

enum ChronicleSessionStatus {
  PREPARATION
  COMPLETED
  ARCHIVED
}

model Chronicle {
  id          String          @id @default(uuid()) @db.Uuid
  narratorId  String          @db.Uuid
  name        String
  description String?
  status      ChronicleStatus @default(PREPARATION)
  experiencePace ChronicleExperiencePace @default(STANDARD)
  currentSituation String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  characters   Character[]            @relation("CharacterChronicle")
  participants ChronicleParticipant[] @relation("ChronicleParticipantChronicle")
  npcs         ChronicleNpc[]          @relation("ChronicleNpcChronicle")
  locations    ChronicleLocation[]     @relation("ChronicleLocationChronicle")
  events       ChronicleEvent[]        @relation("ChronicleEventChronicle")
  sessions     ChronicleSession[]      @relation("ChronicleSessionChronicle")
  stories      ChronicleStory[]        @relation("ChronicleStoryChronicle")
  diceRolls    DiceRollRecord[]         @relation("DiceRollChronicle")
  sessionScenes ChronicleSessionScene[] @relation("ChronicleSessionSceneChronicle")
  sessionPreparationItems ChronicleSessionPreparationItem[] @relation("ChronicleSessionPreparationChronicle")
  sessionParticipantNotes ChronicleSessionParticipantNote[] @relation("ChronicleSessionParticipantNoteChronicle")
  coverImage ChronicleCoverImage?

  @@index([narratorId])
  @@index([status])
  @@map("chronicles")
  resources ChronicleResource[]
}

model ChronicleCoverImage {
  chronicleId String   @id @db.Uuid
  mimeType   String
  byteSize   Int
  sha256     String
  data       Bytes
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation(fields: [chronicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("chronicle_cover_images")
}

enum ChronicleParticipantRole {
  NARRATOR
  PLAYER
}

enum ChronicleParticipantStatus {
  ACTIVE
  RETIRED
}

model ChronicleParticipant {
  id          String                     @id @default(uuid()) @db.Uuid
  chronicleId String                     @db.Uuid
  userId      String                     @db.Uuid
  role        ChronicleParticipantRole
  status      ChronicleParticipantStatus @default(ACTIVE)
  narratorNotes String?
  revision    Int @default(1)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleParticipantChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation("ChronicleParticipantUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([chronicleId, userId])
  @@index([chronicleId, role, status])
  @@index([userId, status])
  @@map("chronicle_participants")
}

enum ChronicleNpcStatus {
  ACTIVE
  ARCHIVED
}

enum ChronicleNpcDetailLevel {
  SIMPLE
  DEEP
}

model ChronicleNpc {
  id            String                  @id @default(uuid()) @db.Uuid
  chronicleId   String                  @db.Uuid
  name          String
  category      String?
  description   String?
  narrativeRole String?
  notes         String?
  status        ChronicleNpcStatus       @default(ACTIVE)
  detailLevel   ChronicleNpcDetailLevel  @default(SIMPLE)
  deepProfile Json?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleNpcChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contextLinks ChronicleSessionNpc[] @relation("ChronicleSessionNpcNpc")
  storyLinks   ChronicleStoryNpc[] @relation("ChronicleStoryNpcNpc")
  eventLinks ChronicleEventNpc[] @relation("ChronicleEventNpcNpc")

  @@index([chronicleId, status])
  @@index([chronicleId, detailLevel])
  @@unique([id, chronicleId])
  @@map("chronicle_npcs")
}

enum ChronicleLocationStatus {
  ACTIVE
  ARCHIVED
}

model ChronicleLocation {
  id               String                  @id @default(uuid()) @db.Uuid
  chronicleId      String                  @db.Uuid
  parentLocationId String?                 @db.Uuid
  name             String
  category         String?
  description      String?
  narratorNotes    String?
  status           ChronicleLocationStatus @default(ACTIVE)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleLocationChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contextLinks ChronicleSessionLocation[] @relation("ChronicleSessionLocationLocation")
  storyLinks   ChronicleStoryLocation[] @relation("ChronicleStoryLocationLocation")
  eventLinks ChronicleEventLocation[] @relation("ChronicleEventLocationLocation")

  parentLocation ChronicleLocation?  @relation("ChronicleLocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childLocations ChronicleLocation[] @relation("ChronicleLocationHierarchy")

  @@index([chronicleId, status])
  @@index([chronicleId, parentLocationId])
  @@index([parentLocationId])
  @@unique([id, chronicleId])
  @@map("chronicle_locations")
}

enum ChronicleEventStatus {
  ACTIVE
  ARCHIVED
}

model ChronicleEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  chronicleId        String               @db.Uuid
  title              String
  description        String?
  narratorNotes      String?
  narrativeTimeLabel String?
  realDate           DateTime?            @db.Timestamptz(3)
  timelineOrder      Int
  status             ChronicleEventStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  chronicle Chronicle @relation("ChronicleEventChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contextLinks ChronicleSessionEvent[] @relation("ChronicleSessionEventEvent")
  storyLinks   ChronicleStoryEvent[] @relation("ChronicleStoryEventEvent")
  characterLinks ChronicleEventCharacter[] @relation("ChronicleEventCharacterEvent")
  npcLinks ChronicleEventNpc[] @relation("ChronicleEventNpcEvent")
  locationLinks ChronicleEventLocation[] @relation("ChronicleEventLocationEvent")

  @@index([chronicleId, status])
  @@index([chronicleId, timelineOrder])
  @@index([chronicleId, realDate])
  @@unique([id, chronicleId])
  @@map("chronicle_events")
}

model ChronicleSession {
    id            String                 @id @default(uuid()) @db.Uuid
    chronicleId   String                 @db.Uuid
    sessionNumber Int?
    title         String?
    realDate      DateTime?              @db.Timestamptz(3)
    status        ChronicleSessionStatus @default(PREPARATION)
    experiencePaceSnapshot ChronicleExperiencePace?
    summary       String?
    narratorNotes String?
    objective String?
    plannedSummary String?
    revision Int @default(1)
    createdAt     DateTime               @default(now()) @db.Timestamptz(3)
    updatedAt     DateTime               @updatedAt @db.Timestamptz(3)

    chronicle Chronicle @relation("ChronicleSessionChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    experienceMovements CharacterExperienceMovement[] @relation("CharacterExperienceSession")
    diceRolls           DiceRollRecord[] @relation("DiceRollSession")
    attendances         ChronicleSessionAttendance[] @relation("ChronicleSessionAttendanceSession")
    eventLinks          ChronicleSessionEvent[] @relation("ChronicleSessionEventSession")
    npcLinks            ChronicleSessionNpc[] @relation("ChronicleSessionNpcSession")
    locationLinks       ChronicleSessionLocation[] @relation("ChronicleSessionLocationSession")
    resourceLinks       ChronicleSessionResource[] @relation("ChronicleSessionResourceSession")
    storyLinks          ChronicleStorySession[] @relation("ChronicleStorySessionSession")
    scenes ChronicleSessionScene[] @relation("ChronicleSessionSceneSession")
    preparationItems ChronicleSessionPreparationItem[] @relation("ChronicleSessionPreparationSession")
    participantNotes ChronicleSessionParticipantNote[] @relation("ChronicleSessionParticipantNoteSession")

    @@index([chronicleId, status])
    @@index([chronicleId, sessionNumber])
    @@index([chronicleId, realDate])
    @@unique([id, chronicleId])
    @@map("chronicle_sessions")
}

model ChronicleSessionParticipantNote {
  id           String   @id @default(uuid()) @db.Uuid
  chronicleId  String   @db.Uuid
  sessionId    String   @db.Uuid
  authorUserId String   @db.Uuid
  privateNotes String?
  publicNotes  String?
  revision     Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  chronicle Chronicle        @relation("ChronicleSessionParticipantNoteChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session   ChronicleSession @relation("ChronicleSessionParticipantNoteSession", fields: [sessionId, chronicleId], references: [id, chronicleId], onDelete: Cascade, onUpdate: Cascade)
  author    User             @relation("ChronicleSessionParticipantNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sessionId, authorUserId])
  @@index([chronicleId, sessionId])
  @@index([authorUserId])
  @@map("chronicle_session_participant_notes")
}

model ChronicleSessionEvent {
  sessionId String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session ChronicleSession @relation("ChronicleSessionEventSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event   ChronicleEvent   @relation("ChronicleSessionEventEvent", fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([sessionId, eventId])
  @@index([eventId])
  @@map("chronicle_session_event_links")
}

model ChronicleSessionNpc {
  sessionId String   @db.Uuid
  npcId     String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session ChronicleSession @relation("ChronicleSessionNpcSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  npc     ChronicleNpc     @relation("ChronicleSessionNpcNpc", fields: [npcId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([sessionId, npcId])
  @@index([npcId])
  @@map("chronicle_session_npc_links")
}

model ChronicleSessionLocation {
  sessionId  String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  session  ChronicleSession  @relation("ChronicleSessionLocationSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location ChronicleLocation @relation("ChronicleSessionLocationLocation", fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([sessionId, locationId])
  @@index([locationId])
  @@map("chronicle_session_location_links")
}

model ChronicleSessionAttendance {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @db.Uuid
  characterId String    @db.Uuid
  removedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  session   ChronicleSession @relation("ChronicleSessionAttendanceSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  character Character        @relation("ChronicleSessionAttendanceCharacter", fields: [characterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sessionId, characterId])
  @@index([sessionId])
  @@index([characterId])
  @@map("chronicle_session_attendances")
}

enum DiceRollSource {
  MANUAL
  CHARACTER
  ACTION
}

enum DiceRollVisibility {
  CONTEXTUAL
  PRIVATE
}

model DiceRollRecord {
  id             String             @id @default(uuid()) @db.Uuid
  actorId        String             @db.Uuid
  characterId    String?            @db.Uuid
  chronicleId    String?            @db.Uuid
  sessionId      String?            @db.Uuid
  rerollParentId String?            @db.Uuid
  source         DiceRollSource
  visibility     DiceRollVisibility @default(CONTEXTUAL)
  description    String?
  rulesVersion   String
  poolSnapshot   Json
  rollSnapshot   Json
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  actor        User              @relation("DiceRollActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  character    Character?        @relation("DiceRollCharacter", fields: [characterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chronicle    Chronicle?        @relation("DiceRollChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session      ChronicleSession? @relation("DiceRollSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rerollParent DiceRollRecord?   @relation("DiceRollRerolls", fields: [rerollParentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rerolls      DiceRollRecord[]  @relation("DiceRollRerolls")
  rouseCheckOperation CharacterRouseCheckOperation? @relation("RouseCheckHistory")

  @@index([actorId, createdAt, id])
  @@index([characterId, createdAt, id])
  @@index([chronicleId, visibility, createdAt, id])
  @@index([sessionId, createdAt, id])
  @@index([rerollParentId])
  @@map("dice_roll_records")
}

enum CharacterExperienceMovementType {
  GRANT
  SPEND
  CORRECTION
}

enum CharacterExperienceComponent {
  EARNED
  SPENT
}

model CharacterExperienceMovement {
  id                 String                       @id @default(uuid()) @db.Uuid
  characterId        String                       @db.Uuid
  actorId            String                       @db.Uuid
  sessionId          String?                      @db.Uuid
  storyId            String?                      @db.Uuid
  type               CharacterExperienceMovementType
  component          CharacterExperienceComponent
  amount             Int
  reason             String
  deduplicationKey   String?
  acquisitionType    String?
  acquisitionKey     String?
  correctsMovementId String?                      @db.Uuid
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)

  character Character @relation("CharacterExperienceCharacter", fields: [characterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor     User      @relation("CharacterExperienceActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session   ChronicleSession? @relation("CharacterExperienceSession", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  story     ChronicleStory? @relation("CharacterExperienceStory", fields: [storyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corrects  CharacterExperienceMovement? @relation("CharacterExperienceCorrection", fields: [correctsMovementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corrections CharacterExperienceMovement[] @relation("CharacterExperienceCorrection")

  @@unique([characterId, deduplicationKey])
  @@index([characterId, createdAt])
  @@index([actorId, createdAt])
  @@index([sessionId])
  @@index([storyId])
  @@unique([characterId, storyId])
  @@index([correctsMovementId])
  @@map("character_experience_movements")
}

model Character {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  chronicleId String?         @db.Uuid
  status      CharacterStatus @default(DRAFT)
  nature      CharacterNature @default(VAMPIRE)
  revision    Int             @default(1)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  owner     User       @relation("CharacterOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chronicle Chronicle? @relation("CharacterChronicle", fields: [chronicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  storyLinks ChronicleStoryCharacter[] @relation("ChronicleStoryCharacterCharacter")
  eventLinks ChronicleEventCharacter[] @relation("ChronicleEventCharacterCharacter")

  identity      CharacterIdentity?
  creationState CharacterCreationState?
  attributes    CharacterAttributes?
  blood         CharacterBloodState?
  bloodResonanceOperations CharacterBloodResonanceOperation[]
  rouseCheckOperations     CharacterRouseCheckOperation[] @relation("RouseCheckCharacter")
  blushOfLifeExemptions    CharacterBlushOfLifeExemptionOperation[] @relation("BlushOfLifeExemptionCharacter")
  damage        CharacterDamageState?
  skills        CharacterSkill[]
  disciplines   CharacterDiscipline[]
  bloodSorceryRituals CharacterBloodSorceryRitual[]
  oblivionCeremonies  CharacterOblivionCeremony[]
  thinBloodAlchemy    CharacterThinBloodAlchemyState?
  thinBloodFormulas   CharacterThinBloodAlchemyFormula[]
  thinBloodTraits     CharacterThinBloodTrait[]
  advantages          CharacterAdvantageSelection[]
  humanity      CharacterHumanityState?
  convictions   CharacterConviction[]
  touchstones   CharacterTouchstone[]
  inventoryItems CharacterInventoryItem[]
  notes          CharacterNote[]
  historyEntries CharacterHistoryEntry[]
  experienceMovements CharacterExperienceMovement[] @relation("CharacterExperienceCharacter")
  diceRolls           DiceRollRecord[] @relation("DiceRollCharacter")
  sessionAttendances  ChronicleSessionAttendance[] @relation("ChronicleSessionAttendanceCharacter")
  portrait            CharacterPortrait?

  @@index([ownerId])
  @@index([chronicleId])
  @@index([status])
  @@unique([id, chronicleId])
  @@map("characters")
}

model CharacterPortrait {
  characterId String   @id @db.Uuid
  mimeType    String
  byteSize    Int
  sha256      String
  data        Bytes
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("character_portraits")
}

model CharacterIdentity {
  id              String  @id @default(uuid()) @db.Uuid
  characterId     String  @unique @db.Uuid
  name            String  @default("")
  concept         String?
  predatorTypeKey String?
  ambition        String?
  clanKey         String?
  sire            String?
  desire          String?
  generation      Int?
  ageCategory     CharacterAgeCategory?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_identities")
}

model CharacterCreationState {
  characterId            String                  @id @db.Uuid
  schemaVersion          Int                     @default(1)
  currentStep            CharacterCreationStep   @default(IDENTITY)
  creationMode           CharacterCreationMode   @default(STANDARD)
  skillDistributionMethod SkillDistributionMethod @default(BALANCED)
  predatorTypeChoices    Json                    @default("{}")
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_creation_states")
}

model CharacterAttributes {
  characterId String @id @db.Uuid
  strength     Int    @default(1)
  dexterity    Int    @default(1)
  stamina      Int    @default(1)
  charisma     Int    @default(1)
  manipulation Int    @default(1)
  composure    Int    @default(1)
  intelligence Int    @default(1)
  wits         Int    @default(1)
  resolve      Int    @default(1)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_attributes")
}

model CharacterBloodState {
  characterId                 String                                  @id @db.Uuid
  bloodPotency                Int                                     @default(1)
  hunger                      Int                                     @default(1)
  resonanceSourceKind         CharacterBloodSourceKind?
  resonanceKey                CharacterBloodResonanceKey?
  resonanceTemperament        CharacterBloodTemperament?
  resonanceSpecialAffinityKey CharacterBloodSpecialAffinityKey?
  dyscrasiaKey                CharacterBloodDyscrasiaKey?
  dyscrasiaAcquisitionMode    CharacterBloodDyscrasiaAcquisitionMode?
  dyscrasiaSourceOperationId  String?                                  @db.Uuid

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_blood_states")
}

model CharacterBloodResonanceOperation {
  characterId              String                                  @db.Uuid
  operationId              String                                  @db.Uuid
  sourceKind               CharacterBloodSourceKind
  resonanceKey             CharacterBloodResonanceKey?
